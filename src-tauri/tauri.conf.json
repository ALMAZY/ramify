{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ramify",
  "version": "0.1.0",
  "identifier": "io.github.almazy.ramify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ramify",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Keyboard-first mind map for fast notes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Aleksandrs Mazurs",
    "copyright": "© 2026 Aleksandrs Mazurs. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/ALMAZY/ramify",
    "longDescription": "A keyboard-first mind map for fast notes: lectures, meetings, research, planning. Every map is a plain Markdown file in a folder you choose.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}